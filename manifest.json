{
  "manifest_version": 3,
  "name": "Freedium - Read Medium Articles Free",
  "version": "2.0.0",
  "description": "Read any Medium article on Freedium in one click.",
  "author": "Rohan Parmar",
  "homepage_url": "https://github.com/therohanparmar/medium-to-freedium",
  "browser_specific_settings": {
    "gecko": {
      "id": "open-in-freedium@rohanparmar",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Open in Freedium",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://medium.com/*",
        "https://*.medium.com/*"
      ],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://freedium-mirror.cfd/*",
        "https://freedium.cfd/*"
      ],
      "js": ["freedium-retry.js"],
      "run_at": "document_start"
    }
  ]
}
